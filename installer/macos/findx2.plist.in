<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.findx.findx2</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PREFIX@/findx2-service</string>
    <string>--index</string>
    <string>__HOME__/Library/Application Support/FindX/index.bin</string>
    <string>--pipe</string>
    <string>findx2</string>
    <string>--volume</string>
    <string>/</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
